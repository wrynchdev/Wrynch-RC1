# Copy to .env.local for local development. Never commit real keys.
# Public (baked into the app):
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
# Server only (Vercel environment variables):
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Tests and local demos only: rule-based stand-in when there is no API key. Never set in production.
# AI_STUB=1
APP_URL=https://app.example.com
# Optional delivery:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
RESEND_API_KEY=
EMAIL_FROM=Your Shop <reports@example.com>
