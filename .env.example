# Copy to .env.local for local development. Never commit real keys.
# Public (baked into the app):
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
# Server only (Vercel environment variables):
SUPABASE_SERVICE_ROLE_KEY=
# Wrynch's own AI account: set one of the two keys (AI_PROVIDER=openai|anthropic only if both are set).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Only for Anthropic keys not created inside a workspace:
ANTHROPIC_WORKSPACE_ID=
# Encrypts shops' own AI keys (32 random bytes, base64). Keep it secret and never change it once set.
SHOP_KEYS_SECRET=
# Tekmetric partner API (optional):
TEKMETRIC_CLIENT_ID=
TEKMETRIC_CLIENT_SECRET=
TEKMETRIC_ENV=sandbox
# Tests and local demos only: rule-based stand-in when there is no API key. Never set in production.
# AI_STUB=1
APP_URL=https://app.example.com
# Domains (defaults shown):
# APP_DOMAIN=wrynch.app
# SITE_DOMAIN=getwrynch.com
# Optional delivery:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
RESEND_API_KEY=
EMAIL_FROM=Your Shop <reports@example.com>

# Pilot applications are emailed here (needs RESEND_API_KEY and EMAIL_FROM)
PILOT_NOTIFY_EMAIL=
